flowchart LR
    merchant[Comerciante]
    subgraph android[Dispositivo Android · objetivo]
      ui[Presentación<br/>Kotlin + Compose]
      domain[Casos de uso y reglas de dominio]
      local[(Room / SQLite<br/>catálogo y ventas locales)]
      outbox[Outbox<br/>UUID y estados]
      worker[WorkManager<br/>sync diferida]
      asr[Vosk / NLU acotado<br/>propuesta, no implementado]
    end
    subgraph server[Servicio remoto · API y catálogo inicial]
      api[API Node.js + TypeScript + Express]
      auth[Login · token corto<br/>propietario administrado]
      products[Catálogo<br/>scope por negocio]
      pool[Adaptador PostgreSQL · pg]
      db[(PostgreSQL)]
    end
    merchant --> ui
    ui --> domain
    domain --> local
    ui -. comandos de voz .-> asr
    local --> outbox
    outbox --> worker
    worker -. HTTPS pendiente antes de red .-> api
    api --> pool
    api --> auth
    api --> products
    auth --> pool
    products --> pool
    pool --> db

    %% Login y operaciones GET/POST de catálogo están implementados; falta verificación de integración local.
    %% Ventas, sync y Android aún no están implementados.
